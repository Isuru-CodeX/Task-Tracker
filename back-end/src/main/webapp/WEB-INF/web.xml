<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- GET TASKS -->
    <servlet>
        <servlet-name>getTasks</servlet-name>
        <servlet-class>servlet.GetTasksServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>getTasks</servlet-name>
        <url-pattern>/tasks</url-pattern>
    </servlet-mapping>

    <!-- ADD TASK -->
    <servlet>
        <servlet-name>addTask</servlet-name>
        <servlet-class>servlet.AddTaskServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>addTask</servlet-name>
        <url-pattern>/addTask</url-pattern>
    </servlet-mapping>

    <!-- UPDATE TASK -->
    <servlet>
        <servlet-name>updateTask</servlet-name>
        <servlet-class>servlet.UpdateTaskServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>updateTask</servlet-name>
        <url-pattern>/updateTask</url-pattern>
    </servlet-mapping>

    <!-- DELETE TASK -->
    <servlet>
        <servlet-name>deleteTask</servlet-name>
        <servlet-class>servlet.DeleteTaskServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>deleteTask</servlet-name>
        <url-pattern>/deleteTask</url-pattern>
    </servlet-mapping>

    <!-- SIGNUP -->
    <servlet>
        <servlet-name>signup</servlet-name>
        <servlet-class>servlet.SignupServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>signup</servlet-name>
        <url-pattern>/signup</url-pattern>
    </servlet-mapping>

    <!-- LOGIN -->
    <servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>


</web-app>
